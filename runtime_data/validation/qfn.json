{
  "schema_version": "packstudio.validation/v1",
  "template_id": "qfn",
  "fields": [
    {
      "key": "footprint.size"
    },
    {
      "key": "package.length",
      "minimum": 2,
      "maximum": 30
    },
    {
      "key": "package.width",
      "minimum": 2,
      "maximum": 30
    },
    {
      "key": "package.standoff",
      "minimum": 0.01,
      "maximum": 0.3
    },
    {
      "key": "encapsulant.thickness",
      "minimum": 0.2,
      "maximum": 5
    },
    {
      "key": "die.length",
      "minimum": 0.2,
      "maximum": 25
    },
    {
      "key": "die.width",
      "minimum": 0.2,
      "maximum": 25
    },
    {
      "key": "die.thickness",
      "minimum": 0.03,
      "maximum": 1.5
    },
    {
      "key": "die.attach",
      "minimum": 0.005,
      "maximum": 0.3
    },
    {
      "key": "die.power",
      "minimum": 0,
      "maximum": 1000
    },
    {
      "key": "pad.length",
      "minimum": 0.5,
      "maximum": 28
    },
    {
      "key": "pad.width",
      "minimum": 0.5,
      "maximum": 28
    },
    {
      "key": "pad.exposed_length",
      "minimum": 0.5,
      "maximum": 28
    },
    {
      "key": "pad.exposed_width",
      "minimum": 0.5,
      "maximum": 28
    },
    {
      "key": "leads.count_x",
      "minimum": 0,
      "maximum": 100
    },
    {
      "key": "leads.count_y",
      "minimum": 0,
      "maximum": 100,
      "required": false
    },
    {
      "key": "leads.pitch_x",
      "minimum": 0.1,
      "maximum": 2
    },
    {
      "key": "leads.pitch_y",
      "minimum": 0.1,
      "maximum": 2,
      "requires_positive": [
        "leads.count_y"
      ]
    },
    {
      "key": "leads.width",
      "minimum": 0.03,
      "maximum": 1
    },
    {
      "key": "leads.length",
      "minimum": 0.05,
      "maximum": 3
    },
    {
      "key": "leads.exposed_thickness",
      "minimum": 0.01,
      "maximum": 0.8
    },
    {
      "key": "leads.thickness",
      "minimum": 0.03,
      "maximum": 1
    },
    {
      "key": "leads.etch",
      "minimum": 0,
      "maximum": 0.5
    },
    {
      "key": "bond_wire.length_x",
      "minimum": 0.05,
      "maximum": 10
    },
    {
      "key": "bond_wire.length_y",
      "minimum": 0.05,
      "maximum": 10
    },
    {
      "key": "bond_wire.diameter",
      "minimum": 0.01,
      "maximum": 0.2
    },
    {
      "key": "thermal_land.enabled"
    },
    {
      "key": "thermal_land.thickness",
      "minimum": 0.001,
      "maximum": 1,
      "active_when": {
        "all": [
          {
            "thermal_land.enabled": true
          }
        ]
      }
    },
    {
      "key": "vias.enabled"
    },
    {
      "key": "vias.length",
      "minimum": 0.001,
      "maximum": 10,
      "active_when": {
        "all": [
          {
            "vias.enabled": true
          }
        ]
      }
    },
    {
      "key": "vias.diameter",
      "minimum": 0.001,
      "maximum": 2,
      "active_when": {
        "all": [
          {
            "vias.enabled": true
          }
        ]
      }
    },
    {
      "key": "vias.plating",
      "minimum": 0.001,
      "maximum": 1,
      "active_when": {
        "all": [
          {
            "vias.enabled": true
          }
        ]
      }
    },
    {
      "key": "vias.pitch",
      "minimum": 0.001,
      "maximum": 10,
      "active_when": {
        "all": [
          {
            "vias.enabled": true
          }
        ]
      }
    },
    {
      "key": "vias.columns",
      "minimum": 1,
      "maximum": 50,
      "active_when": {
        "all": [
          {
            "vias.enabled": true
          }
        ]
      }
    },
    {
      "key": "vias.rows",
      "minimum": 1,
      "maximum": 50,
      "active_when": {
        "all": [
          {
            "vias.enabled": true
          }
        ]
      }
    },
    {
      "key": "grid.enabled"
    },
    {
      "key": "grid.density",
      "active_when": {
        "all": [
          {
            "grid.enabled": true
          }
        ]
      }
    },
    {
      "key": "leads.modeling"
    },
    {
      "key": "bond_wire.steps",
      "minimum": 1,
      "maximum": 100
    },
    {
      "key": "vias.modeling",
      "active_when": {
        "all": [
          {
            "vias.enabled": true
          }
        ]
      }
    },
    {
      "key": "vias.configuration",
      "active_when": {
        "all": [
          {
            "vias.enabled": true
          }
        ]
      },
      "fields": [
        {
          "key": "removal_enabled"
        },
        {
          "key": "removal_rows",
          "minimum": 0,
          "active_when": {
            "all": [
              {
                "removal_enabled": true
              }
            ]
          }
        },
        {
          "key": "removal_columns",
          "minimum": 0,
          "active_when": {
            "all": [
              {
                "removal_enabled": true
              }
            ]
          }
        },
        {
          "key": "omitted_cells",
          "active_when": {
            "all": [
              {
                "removal_enabled": true
              }
            ]
          }
        }
      ]
    }
  ],
  "checks": [
    {
      "id": "input.qfn.lead_height",
      "stage": "input",
      "check": "relation",
      "severity": "error",
      "message": "露出引脚厚度必须小于引脚总厚度。"
    },
    {
      "id": "input.qfn.lead_count",
      "stage": "input",
      "check": "relation",
      "severity": "error",
      "message": "QFN 至少需要一组引脚。"
    },
    {
      "id": "input.qfn.lead_span",
      "stage": "input",
      "check": "relation",
      "severity": "error",
      "message": "QFN 引脚跨度必须位于封装内。"
    },
    {
      "id": "input.qfn.wire_endpoint",
      "stage": "input",
      "check": "relation",
      "severity": "error",
      "message": "QFN 键合线焊盘必须位于芯片外。"
    },
    {
      "id": "input.qfn.via_span",
      "stage": "input",
      "check": "relation",
      "severity": "error",
      "message": "QFN 通孔必须位于露出焊盘内。"
    }
  ]
}
