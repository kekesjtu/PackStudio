{
  "schema_version": "packstudio.validation/v1",
  "template_id": "sop",
  "fields": [
    {
      "key": "package.type"
    },
    {
      "key": "footprint.size"
    },
    {
      "key": "package.length",
      "minimum": 2,
      "maximum": 30,
      "required": false
    },
    {
      "key": "package.width",
      "minimum": 2,
      "maximum": 30
    },
    {
      "key": "package.standoff",
      "minimum": 0,
      "maximum": 3
    },
    {
      "key": "body.length",
      "minimum": 1,
      "maximum": 30
    },
    {
      "key": "body.width",
      "minimum": 1,
      "maximum": 25
    },
    {
      "key": "body.thickness",
      "minimum": 0.3,
      "maximum": 6
    },
    {
      "key": "die.length",
      "minimum": 0.2,
      "maximum": 20
    },
    {
      "key": "die.width",
      "minimum": 0.2,
      "maximum": 20
    },
    {
      "key": "die.thickness",
      "minimum": 0.03,
      "maximum": 2
    },
    {
      "key": "die.attach",
      "minimum": 0.005,
      "maximum": 0.3
    },
    {
      "key": "die.power",
      "minimum": 0,
      "maximum": 1000
    },
    {
      "key": "flag.length",
      "minimum": 0.3,
      "maximum": 25
    },
    {
      "key": "flag.width",
      "minimum": 0.3,
      "maximum": 20
    },
    {
      "key": "flag.thickness",
      "minimum": 0.03,
      "maximum": 1
    },
    {
      "key": "flag.coverage",
      "minimum": 1,
      "maximum": 100
    },
    {
      "key": "flag.downset",
      "minimum": 0,
      "maximum": 2
    },
    {
      "key": "tie_bar.width",
      "minimum": 0.05,
      "maximum": 2
    },
    {
      "key": "leads.total",
      "minimum": 2,
      "maximum": 100
    },
    {
      "key": "leads.gap",
      "minimum": 0.01,
      "maximum": 3
    },
    {
      "key": "leads.pitch",
      "minimum": 0.1,
      "maximum": 3
    },
    {
      "key": "leads.width",
      "minimum": 0.03,
      "maximum": 1.5
    },
    {
      "key": "leads.thickness",
      "minimum": 0.03,
      "maximum": 1
    },
    {
      "key": "leads.height",
      "minimum": 0.05,
      "maximum": 3
    },
    {
      "key": "leads.foot_length",
      "minimum": 0.05,
      "maximum": 3
    },
    {
      "key": "bond_wire.count",
      "minimum": 0,
      "maximum": 200
    },
    {
      "key": "bond_wire.diameter",
      "minimum": 0.01,
      "maximum": 0.2
    },
    {
      "key": "thermal_land.enabled"
    },
    {
      "key": "thermal_land.thickness",
      "minimum": 0.001,
      "maximum": 1,
      "active_when": {
        "all": [
          {
            "thermal_land.enabled": true
          }
        ]
      }
    },
    {
      "key": "grid.enabled"
    },
    {
      "key": "grid.density",
      "active_when": {
        "all": [
          {
            "grid.enabled": true
          }
        ]
      }
    },
    {
      "key": "bond_wire.modeling"
    },
    {
      "key": "package.exposed_pad"
    },
    {
      "key": "leads.custom_coverage"
    },
    {
      "key": "leads.coverage",
      "minimum": 0,
      "maximum": 100,
      "active_when": {
        "all": [
          {
            "leads.custom_coverage": true
          }
        ]
      }
    }
  ],
  "checks": [
    {
      "id": "input.sop.leads",
      "stage": "input",
      "check": "sop_lead_count",
      "severity": "error",
      "message": "SOP 引脚数量必须为偶数。"
    }
  ]
}
