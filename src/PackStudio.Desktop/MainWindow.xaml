<Window x:Class="PackStudio.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fluent="urn:fluent-ribbon" xmlns:ad="clr-namespace:AvalonDock;assembly=AvalonDock" xmlns:layout="clr-namespace:AvalonDock.Layout;assembly=AvalonDock" xmlns:helix="http://helix-toolkit.org/wpf" Title="PackStudio — IC 封装参数化建模" Width="1500" Height="960" MinWidth="1080" MinHeight="720" Background="#F4F6F8" FontFamily="Microsoft YaHei UI" FontSize="13" WindowStartupLocation="CenterScreen">
<DockPanel>
<fluent:Ribbon DockPanel.Dock="Top" IsQuickAccessToolBarVisible="False" IsToolBarVisible="False">
<fluent:RibbonTabItem Header="建模">
<fluent:RibbonGroupBox Header="方案"><fluent:Button x:Name="NewPackageButton" Header="新建" Click="New_Click"><fluent:Button.LargeIcon><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;" FontSize="24" Foreground="#395D87"/></fluent:Button.LargeIcon></fluent:Button><fluent:Button Header="打开" Click="Open_Click"><fluent:Button.LargeIcon><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8E5;" FontSize="24" Foreground="#395D87"/></fluent:Button.LargeIcon></fluent:Button><fluent:Button Header="保存方案" Click="Save_Click"><fluent:Button.LargeIcon><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74E;" FontSize="24" Foreground="#395D87"/></fluent:Button.LargeIcon></fluent:Button></fluent:RibbonGroupBox>
<fluent:RibbonGroupBox Header="模型"><fluent:Button Header="生成模型" Command="{Binding GenerateCommand}"><fluent:Button.LargeIcon><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE768;" FontSize="24" Foreground="#395D87"/></fluent:Button.LargeIcon></fluent:Button><fluent:Button x:Name="ExportButton" Header="导出 FloXML" Click="Export_Click" IsEnabled="{Binding IsCurrent}"><fluent:Button.LargeIcon><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" FontSize="24" Foreground="#395D87"/></fluent:Button.LargeIcon></fluent:Button><fluent:Button Header="材料库" Click="Materials_Click"><fluent:Button.LargeIcon><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8F1;" FontSize="24" Foreground="#395D87"/></fluent:Button.LargeIcon></fluent:Button></fluent:RibbonGroupBox>
<fluent:RibbonGroupBox Header="视图"><fluent:Button Header="适应窗口" Click="Fit_Click"><fluent:Button.LargeIcon><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9A6;" FontSize="24" Foreground="#395D87"/></fluent:Button.LargeIcon></fluent:Button><fluent:Button Header="显示全部" Click="ShowAll_Click"><fluent:Button.LargeIcon><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE890;" FontSize="24" Foreground="#395D87"/></fluent:Button.LargeIcon></fluent:Button><fluent:Button Header="隐藏全部" Click="HideAll_Click"><fluent:Button.LargeIcon><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xED1A;" FontSize="24" Foreground="#395D87"/></fluent:Button.LargeIcon></fluent:Button><fluent:Button Header="全部展开" Click="Expand_Click"><fluent:Button.LargeIcon><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A3;" FontSize="24" Foreground="#395D87"/></fluent:Button.LargeIcon></fluent:Button><fluent:Button Header="全部折叠" Click="Collapse_Click"><fluent:Button.LargeIcon><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A4;" FontSize="24" Foreground="#395D87"/></fluent:Button.LargeIcon></fluent:Button></fluent:RibbonGroupBox>
</fluent:RibbonTabItem></fluent:Ribbon>
<StatusBar DockPanel.Dock="Bottom" Background="#E8EDF2"><StatusBarItem><TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis"/></StatusBarItem><Separator/><StatusBarItem><TextBlock Text="mm · W · W/(m·K)"/></StatusBarItem></StatusBar>
<ad:DockingManager x:Name="DockManager">
<layout:LayoutRoot><layout:LayoutPanel Orientation="Horizontal">
<layout:LayoutAnchorablePane DockWidth="425"><layout:LayoutAnchorable Title="封装向导" CanClose="False" CanHide="False" CanFloat="False">
<Grid Margin="5,0,5,5" Background="#F1F1F1">
  <Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="*" MinHeight="190"/><RowDefinition Height="6"/><RowDefinition Height="310" MinHeight="180"/></Grid.RowDefinitions>
  <Grid Margin="8,8,5,8">
    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <ContentControl x:Name="PackagePreview" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
      <TextBlock x:Name="PackageTitle" FontWeight="SemiBold" FontSize="14"/>
      <TextBlock x:Name="PackageSubtitle" TextWrapping="Wrap" FontSize="11" Foreground="#526174" Margin="0,4,0,0"/>
    </StackPanel>
  </Grid>
  <ListBox x:Name="StepList" Grid.Row="1" SelectedValuePath="Key" SelectionChanged="Step_Changed"
           Background="White" BorderBrush="#B8B8B8" BorderThickness="1" Padding="0"
           ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    <ListBox.ItemContainerStyle>
      <Style TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="4,3"/>
        <Setter Property="Template">
          <Setter.Value><ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Selection" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Selection" Property="Background" Value="#CEE7EB"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Selection" Property="Background" Value="#E4F0F3"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate></Setter.Value>
        </Setter>
      </Style>
    </ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate><DataTemplate><DockPanel><TextBlock Text="◆" Foreground="#1659AB" Margin="0,0,8,0"/><TextBlock Text="{Binding Label}" VerticalAlignment="Center"/></DockPanel></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="#E4E4E4"/>
  <DockPanel Grid.Row="3" Margin="5,6,3,0">
    <TextBlock x:Name="SectionTitle" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="2,0,0,9"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="FieldsPanel" Margin="0,0,7,0"/></ScrollViewer>
  </DockPanel>
</Grid></layout:LayoutAnchorable></layout:LayoutAnchorablePane>
<layout:LayoutDocumentPane><layout:LayoutDocument Title="三维模型" CanClose="False" CanFloat="False"><Grid Background="#EDF1F5">
<helix:HelixViewport3D x:Name="Viewport" ShowCoordinateSystem="True" ShowViewCube="True" ZoomExtentsWhenLoaded="True" Background="#EDF1F5" PreviewMouseLeftButtonDown="Viewport_MouseDown"><helix:HelixViewport3D.Camera><PerspectiveCamera Position="20,-28,22" LookDirection="-20,28,-20" UpDirection="0,0,1" FieldOfView="40"/></helix:HelixViewport3D.Camera><helix:DefaultLights/></helix:HelixViewport3D>
<Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="16" Padding="12,8" Background="#EEFFFFFF" CornerRadius="4"><TextBlock Text="旋转：鼠标右键拖动    缩放：滚轮    平移：Shift + 右键" Foreground="#526174" FontSize="11"/></Border>
<Border VerticalAlignment="Bottom" Margin="12" Padding="10" Background="#EEFFFFFF" CornerRadius="4"><TextBlock x:Name="WarningsText" TextWrapping="Wrap" Foreground="#9A6200"/></Border>
</Grid></layout:LayoutDocument></layout:LayoutDocumentPane>
<layout:LayoutAnchorablePane DockWidth="300"><layout:LayoutAnchorable Title="模型树与属性" CanClose="False" CanHide="False" CanFloat="False"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="6"/><RowDefinition Height="*"/></Grid.RowDefinitions><TreeView x:Name="ModelTree" BorderThickness="0" Background="Transparent" PreviewMouseLeftButtonDown="Tree_MouseDown"/><GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"/><ScrollViewer Grid.Row="2"><TextBlock x:Name="Inspector" Margin="6,12" TextWrapping="Wrap" Foreground="#344255"/></ScrollViewer></Grid></layout:LayoutAnchorable></layout:LayoutAnchorablePane>
</layout:LayoutPanel></layout:LayoutRoot></ad:DockingManager>
</DockPanel></Window>
