<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:PackStudio.Desktop">
  <Style x:Key="TreeExpander" TargetType="ToggleButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Width" Value="13"/>
    <Setter Property="Height" Value="13"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border BorderBrush="#94A3B4" BorderThickness="1" CornerRadius="1" Background="White">
            <Grid Margin="2"><Path Stroke="#526174" StrokeThickness="1" Data="M0,3.5 L7,3.5"/>
              <Path x:Name="VerticalStroke" Stroke="#526174" StrokeThickness="1" Data="M3.5,0 L3.5,7"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="VerticalStroke" Property="Visibility" Value="Collapsed"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ExplorerTreeItem" TargetType="TreeViewItem">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TreeViewItem">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ToggleButton x:Name="Expander" Style="{StaticResource TreeExpander}"
                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
            <Border x:Name="RowBackground" Grid.Column="1" Padding="3,0,3,0" Background="Transparent"
                    BorderBrush="#F1F4F7" BorderThickness="0,0,0,1">
              <ContentPresenter x:Name="PART_Header" ContentSource="Header" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
            </Border>
            <ItemsPresenter x:Name="Children" Grid.Row="1" Grid.ColumnSpan="2" Margin="20,0,0,0"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden"/></Trigger>
            <Trigger Property="IsExpanded" Value="False"><Setter TargetName="Children" Property="Visibility" Value="Collapsed"/></Trigger>
            <Trigger SourceName="RowBackground" Property="IsMouseOver" Value="True"><Setter TargetName="RowBackground" Property="Background" Value="#F0F5FA"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="RowBackground" Property="Background" Value="#E1EDFA"/></Trigger>
            <Trigger Property="local:TreeRow.IsHighlighted" Value="True"><Setter TargetName="RowBackground" Property="Background" Value="#D8E9FB"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ExplorerModelRootItem" TargetType="local:ModelRootItem" BasedOn="{StaticResource ExplorerTreeItem}">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:ModelRootItem">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border x:Name="RowBackground" Padding="23,0,3,0" BorderBrush="#F1F4F7" BorderThickness="0,0,0,1">
              <ContentPresenter x:Name="PART_Header" ContentSource="Header" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
            </Border>
            <ItemsPresenter Grid.Row="1" Margin="20,0,0,0"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ExplorerTree" TargetType="TreeView">
    <Setter Property="ItemContainerStyle" Value="{StaticResource ExplorerTreeItem}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Background" Value="White"/>
    <Setter Property="Padding" Value="2,4"/>
  </Style>
</ResourceDictionary>
