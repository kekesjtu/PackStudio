{
  "name": "packstudio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node tools/start_frontend_dev.mjs",
    "preview": "vite preview",
    "build": "tsc -b && vite build",
    "lint": "eslint src/frontend tests/frontend",
    "test": "vitest run",
    "test:startup": "node --test tests/startup/*.test.mjs",
    "test:desktop": "dotnet restore tests/webview2/PackStudio.WebView2.Smoke.csproj --locked-mode && dotnet run --project tests/webview2/PackStudio.WebView2.Smoke.csproj -c Release --no-restore",
    "desktop": "powershell -NoProfile -File tools/start_webview2.ps1",
    "package:backend": "uv run --locked --group packaging python tools/build_backend.py",
    "package:desktop": "powershell -NoProfile -File tools/package_webview2.ps1",
    "dist": "npm run package:desktop"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^7.0.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^16.0.0",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
