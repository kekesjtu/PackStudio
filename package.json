{
  "name": "packstudio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint src/frontend tests/frontend",
    "test": "vitest run",
    "desktop": "npm run build && electron .",
    "package:backend": "conda run -n PackStudio python -m PyInstaller --noconfirm --clean --name packstudio-backend --onedir --paths src --exclude-module uvloop --distpath release/backend --workpath build/pyinstaller src/packstudio/__main__.py",
    "package:desktop": "npm run build && npm run package:backend && electron-builder --win --dir",
    "dist": "npm run build && npm run package:backend && electron-builder --win"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^7.0.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^16.0.0",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
