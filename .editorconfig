root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# Windows PowerShell 5 requires a BOM to read Chinese script messages as UTF-8.
[tools/*webview2.ps1]
charset = utf-8-bom
