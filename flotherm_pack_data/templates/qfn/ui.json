{
  "schema_version": "1.0",
  "template_id": "qfn",
  "software_version": "2504",
  "capture_status": "complete",
  "starter_fields": [
    {
      "name": "Design Name",
      "property": "designName",
      "control": "text",
      "default": "QFN"
    },
    {
      "name": "Outline Type",
      "property": "outlineType",
      "control": "select",
      "default": "standardOutline",
      "options": ["standardOutline", "nonStandardOutline"],
      "screenshot": "screenshots/dropdown_outline_type.png"
    },
    {
      "name": "JEDEC Footprint",
      "property": "jedecFootprint",
      "control": "select",
      "default": "QFN_12X12_100",
      "options": [
        "QFN_12X12_100",
        "QFN_10X10_68",
        "QFN_10X10_72",
        "QFN_10X10_44",
        "QFN_10X10_52",
        "QFN_9X9_56",
        "QFN_9X9_60",
        "QFN_9X9_48",
        "QFN_9X9_64",
        "QFN_9X9_44",
        "QFN_8X8_48",
        "QFN_8X8_52",
        "QFN_8X8_56",
        "QFN_8X8_40",
        "QFN_8X8_32",
        "QFN_7X7_32",
        "QFN_7X7_48",
        "QFN_7X7_40",
        "QFN_7X7_36",
        "QFN_7X7_44",
        "QFN_7X7_28",
        "QFN_7X5_38",
        "QFN_6X6_40",
        "QFN_6X6_36",
        "QFN_6X6_32",
        "QFN_6X6_28",
        "QFN_6X6_24",
        "QFN_6X6_20",
        "QFN_5X5_32",
        "QFN_5X5_28",
        "QFN_5X5_24",
        "QFN_5X5_20",
        "QFN_5X5_16",
        "QFN_5X4_28",
        "QFN_5X4_24",
        "QFN_5_5X3_5_24",
        "QFN_4X4_24",
        "QFN_4X4_20",
        "QFN_4X4_16_0_65",
        "QFN_4X4_16_0_8",
        "QFN_4X4_12",
        "QFN_4_5X3_5_20",
        "QFN_3X3_6",
        "QFN_3X3_16",
        "QFN_3X3_12",
        "QFN_3X3_8"
      ],
      "visible_when": {"outlineType": "standardOutline"},
      "screenshots": [
        "screenshots/dropdown_jedec_footprint.png",
        "screenshots/dropdown_jedec_footprint_scrolled.png",
        "screenshots/dropdown_jedec_footprint_scrolled_2.png",
        "screenshots/dropdown_jedec_footprint_scrolled_3.png",
        "screenshots/dropdown_jedec_footprint_scrolled_4.png",
        "screenshots/dropdown_jedec_footprint_scrolled_5.png",
        "screenshots/dropdown_jedec_footprint_scrolled_6.png"
      ]
    }
  ],
  "common_material_groups": [
    "Alloys (Leadframe)",
    "Alloys (Other)",
    "Alloys (Solders)",
    "Attachment Materials",
    "Ceramics",
    "Metals",
    "Others",
    "Resins",
    "Semiconductors",
    "Substrate Dielectrics"
  ],
  "steps": [
    {
      "id": "summary",
      "label": "Summary",
      "screenshot": "screenshots/step_01_summary.png",
      "fields": [
        {"name": "Design Name", "control": "text", "default": "QFN"},
        {"name": "Part Number", "control": "text", "default": ""},
        {"name": "Vendor Name", "control": "text", "default": ""},
        {"name": "Max Power", "control": "number", "unit": "W", "default": null},
        {"name": "Max Operating Junction Temperature", "control": "number", "unit": "degC", "default": null},
        {"name": "Max Case Temperature", "control": "number", "unit": "degC", "default": null},
        {"name": "Notes", "control": "multiline_text", "default": ""}
      ]
    },
    {
      "id": "overall_package",
      "label": "Overall Package",
      "screenshot": "screenshots/step_02_overall_package.png",
      "fields": [
        {"name": "Length D", "control": "number", "unit": "mm", "default": 12},
        {"name": "Width E", "control": "number", "unit": "mm", "default": 12},
        {"name": "Standoff A1", "control": "number", "unit": "mm", "default": 0.05},
        {"name": "Encapsulant Thickness A2", "control": "number", "unit": "mm", "default": 0.85},
        {"name": "Material Group", "control": "select", "default": "Resins", "options_ref": "common_material_groups"},
        {"name": "Encapsulant Material", "control": "select", "default": "EME-7730LF"}
      ]
    },
    {
      "id": "die",
      "label": "Die",
      "screenshot": "screenshots/step_03_die.png",
      "fields": [
        {"name": "Package Power", "control": "number", "unit": "W", "default": 0, "hidden_when": {"Non-uniform Die Heat": true}},
        {"name": "Non-uniform Die Heat", "control": "checkbox", "default": false},
        {"name": "Click To Edit", "control": "button", "default_enabled": false, "enabled_when": {"Non-uniform Die Heat": true}},
        {"name": "Die Length Ld", "control": "number", "unit": "mm", "default": 5.4},
        {"name": "Die Width Wd", "control": "number", "unit": "mm", "default": 5.4},
        {"name": "Die Thickness td", "control": "number", "unit": "mm", "default": 0.25},
        {"name": "Die Attach Thickness tda", "control": "number", "unit": "mm", "default": 0.025},
        {"name": "Material Group", "control": "select", "default": "Attachment Materials", "options_ref": "common_material_groups"},
        {"name": "Die Attach Material", "control": "select", "default": "DieAttach-2600BT"}
      ],
      "conditional_screenshots": ["screenshots/conditional_non_uniform_die_heat_on.png"]
    },
    {
      "id": "lead_and_solder_interconnect",
      "label": "Lead & Solder Interconnect",
      "screenshot": "screenshots/step_04_lead_solder_interconnect.png",
      "fields": [
        {"name": "Exposed Lead Length L", "control": "number", "unit": "mm", "default": 0.5},
        {"name": "Lead Width b", "control": "number", "unit": "mm", "default": 0.2},
        {"name": "Exposed Lead Thickness", "control": "number", "unit": "mm", "default": 0.1},
        {"name": "Lead Thickness A3", "control": "number", "unit": "mm", "default": 0.2},
        {"name": "Lead Etch", "control": "number", "unit": "mm", "default": 0.05},
        {"name": "Leadframe Material Group", "control": "select", "default": "Alloys (Leadframe)", "options_ref": "common_material_groups"},
        {"name": "Lead Frame Material", "control": "select", "default": "Cu-C19400"},
        {"name": "Pitch in X Direction ex", "control": "number", "unit": "mm", "default": 0.4},
        {"name": "Pitch in Y Direction ey", "control": "number", "unit": "mm", "default": 0.4},
        {"name": "Solder Material Group", "control": "select", "default": "Alloys (Solders)", "options_ref": "common_material_groups"},
        {"name": "Solder Material", "control": "select", "default": "Solder (Sn63/Pb37)"},
        {"name": "Number of Leads on Top/Bottom MD", "control": "integer_spinbox", "default": 25},
        {"name": "Number of Leads on Left/Right ME", "control": "integer_spinbox", "default": 25}
      ]
    },
    {
      "id": "dap",
      "label": "DAP",
      "screenshot": "screenshots/step_05_dap.png",
      "fields": [
        {"name": "DAP Length Lp", "control": "number", "unit": "mm", "default": 10.8},
        {"name": "DAP Width Wp", "control": "number", "unit": "mm", "default": 10.8},
        {"name": "Exposed PAD Length", "control": "number", "unit": "mm", "default": 10.55},
        {"name": "Exposed PAD Width", "control": "number", "unit": "mm", "default": 10.55},
        {"name": "Material Group", "control": "select", "default": "Alloys (Leadframe)", "options_ref": "common_material_groups"},
        {"name": "Material", "control": "select", "default": "Cu-C19400"}
      ]
    },
    {
      "id": "bond_wires",
      "label": "Bond Wires",
      "screenshot": "screenshots/step_06_bond_wires.png",
      "fields": [
        {"name": "Bond Wire Length On Left/Right Lbwx", "control": "number", "unit": "mm", "default": 2.75},
        {"name": "Bond Wire Length On Top/Bottom Lbwy", "control": "number", "unit": "mm", "default": 2.75},
        {"name": "Bond Wire Diameter dbw", "control": "number", "unit": "mm", "default": 0.03},
        {"name": "Material Group", "control": "select", "default": "Metals", "options_ref": "common_material_groups"},
        {"name": "Material", "control": "select", "default": "Gold (Pure)"}
      ]
    },
    {
      "id": "thermal_land",
      "label": "Thermal Land",
      "screenshot": "screenshots/step_07_thermal_land.png",
      "fields": [
        {"name": "Include Land", "control": "checkbox", "default": false},
        {"name": "Land Thickness", "control": "number", "unit": "mm", "default": null, "enabled_when": {"Include Land": true}},
        {"name": "Material Group", "control": "select", "default": "Alloys (Leadframe)", "enabled_when": {"Include Land": true}, "options_ref": "common_material_groups"},
        {"name": "Material", "control": "select", "default": "No Attachment", "enabled_when": {"Include Land": true}}
      ],
      "conditional_screenshots": ["screenshots/conditional_include_land_on.png"]
    },
    {
      "id": "vias",
      "label": "Vias",
      "screenshot": "screenshots/step_08_vias.png",
      "fields": [
        {"name": "Model Vias As", "control": "select", "default": "ignored", "options": ["discrete", "lumped", "ignored"], "screenshot": "screenshots/dropdown_model_vias_as.png"},
        {"name": "Vias Length Lv", "control": "number", "unit": "mm", "default": null, "enabled_unless": {"Model Vias As": "ignored"}},
        {"name": "Vias Diameter Dv", "control": "number", "unit": "mm", "default": null, "enabled_unless": {"Model Vias As": "ignored"}},
        {"name": "Plating Thickness tpl", "control": "number", "unit": "mm", "default": null, "enabled_unless": {"Model Vias As": "ignored"}},
        {"name": "Vias Pitch ev", "control": "number", "unit": "mm", "default": null, "enabled_unless": {"Model Vias As": "ignored"}},
        {"name": "Number of Vias in X VD", "control": "integer_spinbox", "default": null, "enabled_unless": {"Model Vias As": "ignored"}},
        {"name": "Number of Vias in Y VE", "control": "integer_spinbox", "default": null, "enabled_unless": {"Model Vias As": "ignored"}}
      ],
      "conditional_screenshots": [
        "screenshots/conditional_model_vias_discrete.png",
        "screenshots/conditional_model_vias_lumped.png"
      ]
    },
    {
      "id": "modeling_options",
      "label": "Modeling Options",
      "screenshot": "screenshots/step_09_modeling_options.png",
      "fields": [
        {"name": "Model Leads and Solder Interconnect As", "control": "select", "default": "discreteLeads", "options": ["discreteLeads", "orthotropicCuboid"], "screenshot": "screenshots/dropdown_model_leads_solder.png"},
        {"name": "Model Bond Wires As", "control": "read_only_single_option", "default": "lumped", "options": ["lumped"]},
        {"name": "Number of Discrete Steps", "control": "integer_spinbox", "default": null},
        {"name": "Localize Grid", "control": "checkbox", "default": true},
        {"name": "Grid Density", "control": "select", "default": "fine", "options": ["coarse", "medium", "fine"], "screenshots": ["screenshots/dropdown_grid_density.png", "screenshots/dropdown_grid_density_popup.png"]}
      ],
      "conditional_screenshots": ["screenshots/conditional_model_leads_orthotropic.png"],
      "realized_geometry_screenshots": [
        "screenshots/tree_realized_geometry_top.png",
        "screenshots/tree_realized_geometry_scrolled.png",
        "screenshots/tree_realized_geometry_scrolled_2.png",
        "screenshots/tree_realized_geometry_scrolled_3.png",
        "screenshots/tree_realized_geometry_scrolled_4.png"
      ]
    }
  ]
}
