{
  "schema_version": "1.0",
  "template_id": "soic_family",
  "software_version": "2504",
  "capture_status": "complete",
  "starter_fields": [
    {"name": "Design Name", "property": "designName", "control": "text", "default": "SOP"},
    {
      "name": "Outline Type",
      "property": "outlineType",
      "control": "select",
      "default": "standardOutline",
      "options": [
        {"label": "Standard Outline", "value": "standardOutline"},
        {"label": "Non-Standard Outline", "value": "nonStandardOutline"}
      ],
      "screenshot": "screenshots/dropdown_outline_type.png"
    },
    {
      "name": "SOP Package Type",
      "property": "sopPackageType",
      "control": "select",
      "default": "soic/sop/so",
      "options": [
        {"label": "SOIC/SOP/SO", "value": "soic/sop/so"},
        {"label": "SSOP", "value": "ssop"},
        {"label": "TSOP", "value": "tsop"},
        {"label": "TSSOP", "value": "tssop"}
      ],
      "visible_when": {"outlineType": "standardOutline"},
      "screenshot": "screenshots/dropdown_sop_package_type.png"
    },
    {
      "name": "JEDEC Footprint",
      "control": "select",
      "default": "SOP_8_3_81x4_93",
      "visible_when": {"outlineType": "standardOutline"},
      "property_by_package_type": {
        "soic/sop/so": "sopJedecFootprint",
        "ssop": "ssopJedecFootprint",
        "tsop": "tsopJedecFootprint",
        "tssop": "tssopJedecFootprint"
      },
      "options_by_package_type": {
        "soic/sop/so": [
          "SOP_8_3_81x4_93", "SOP_14_3_81x8_69", "SOP_16_3_81x9_93", "SOP_16_7_6x10_3",
          "SOP_18_7_6x11_6", "SOP_20_7_6x12_8", "SOP_24_7_6x15_4", "SOP_28_7_6x17_9",
          "SOP_28_8_9x18_1", "SOP_28_10_2x18_4", "SOP_32_7_6x20_8", "SOP_32_8_9x20_8",
          "SOP_32_10_2x21_0", "SOP_40_10_2x26_1", "SOP_44_13_3x28_2"
        ],
        "ssop": [
          "SSOP_8_5_3x3_0", "SSOP_16_8_9x4_9", "SSOP_16_5_3x6_2", "SSOP_20_8_9x8_6",
          "SSOP_20_5_3x7_2", "SSOP_24_8_9x8_6", "SSOP_24_5_3x8_2", "SSOP_28_8_9x9_9",
          "SSOP_28_5_3x10_2", "SSOP_36_7_5x15_4", "SSOP_48_7_5x15_8", "SSOP_56_7_5x15_8",
          "SSOP_56_7_5x18_3", "SSOP_64_10_2x25_9"
        ],
        "tsop": [
          "TSOP_20_7_6x17_1", "TSOP_24_7_6x17_1", "TSOP_26_7_6x17_1", "TSOP_28_8x20",
          "TSOP_32_8x14", "TSOP_32_8x20", "TSOP_32_10_16x20_95", "TSOP_40_10_2x18_4",
          "TSOP_40_10x14", "TSOP_40_10x20"
        ],
        "tssop": [
          "TSSOP_8_3x3", "TSSOP_8_4_4x3", "TSSOP_10_3x3", "TSSOP_14_4_4x5",
          "TSSOP_16_4_4x5", "TSSOP_20_4_4x6_5", "TSSOP_24_4_4x7_8", "TSSOP_28_4_4x9_7",
          "TSSOP_28_6_1x9_7", "TSSOP_30_4_4x7_8"
        ]
      },
      "screenshots": [
        "screenshots/dropdown_jedec_soic_01.png", "screenshots/dropdown_jedec_soic_02.png",
        "screenshots/dropdown_jedec_ssop_01.png", "screenshots/dropdown_jedec_ssop_02.png",
        "screenshots/dropdown_jedec_tsop.png", "screenshots/dropdown_jedec_tssop.png"
      ]
    },
    {
      "name": "Die Type",
      "property": "dieType",
      "control": "select",
      "default": "actualDie",
      "options": [
        {"label": "Actual Die", "value": "actualDie"},
        {"label": "Thermal Die", "value": "thermalDie"}
      ],
      "screenshot": "screenshots/dropdown_die_type.png"
    },
    {
      "name": "Exposed Pad",
      "property": "exposedPad",
      "control": "checkbox",
      "default": false,
      "conditional_screenshot": "screenshots/conditional_exposed_pad_on.png"
    }
  ],
  "common_material_groups": [
    "Alloys (Leadframe)", "Alloys (Other)", "Alloys (Solders)", "Attachment Materials",
    "Ceramics", "Metals", "Others", "Resins", "Semiconductors", "Substrate Dielectrics"
  ],
  "material_option_sets": {
    "resins": [
      "No Attachment", "Cookson-7115", "Cookson-AMC-2F1", "Cookson-AMC-2RC", "Cookson-SMT-B-1FX",
      "EME-7730LF", "Epoxy Overmold (High-k)", "Epoxy Overmold (Typical)", "G700", "Hysol 4450",
      "Material", "Material1", "Material2", "Material3", "Nitto-HC100X2", "Nitto-MP8000AN",
      "Nitto-MP8000CH4", "Nylon-6 (Typical)", "Nylon-66 (Typical)", "PLASKON7060", "PTFE (Typical)",
      "Polycarbonate (Typical)", "Polyisoprene (Hard)", "Polyisoprene (Natural)", "Polystyrene (Typical)",
      "Sumitomo-6300H", "Sumitomo-7050A2", "Sumitomo-EME1100R", "Sumitomo-EME6700",
      "Sumitomo-EME6710", "Sumitomo-EME6730B", "Sumitomo-EME7302CR", "Sumitomo-EME7351",
      "Sumitomo-EME7351LS", "Sumitomo-EME7740"
    ],
    "leadframe_alloys": [
      "Cu-C15715", "Cu-C19010", "Cu-C19210", "Cu-C19400", "Cu-C19500",
      "Cu-C19700", "Cu-C50710", "Cu-C7025", "Cu-CDA-194", "Cu-EFTEC-23Z"
    ],
    "metals": [
      "No Attachment", "Aluminum (Anodized)", "Aluminum (Pure)", "Copper (Pure)", "Gold (Pure)",
      "Iron (Pure)", "Magnesium (Pure)", "Molybdenum (Pure)", "Nickel (Pure)", "Platinum (Pure)",
      "Silver (Pure)", "Titanium (Pure)", "Tungsten (Pure)", "Zinc (Pure)"
    ]
  },
  "steps": [
    {
      "id": "summary",
      "label": "Summary",
      "screenshot": "screenshots/step_01_summary.png",
      "fields": [
        {"name": "Design Name", "control": "text", "default": "SOP"},
        {"name": "Part Number", "control": "text", "default": ""},
        {"name": "Vendor Name", "control": "text", "default": ""},
        {"name": "Max Power", "control": "number", "unit": "W", "default": null},
        {"name": "Max Operating Junction Temperature", "control": "number", "unit": "degC", "default": null},
        {"name": "Max Case Temperature", "control": "number", "unit": "degC", "default": null},
        {"name": "Notes", "control": "multiline_text", "default": ""}
      ]
    },
    {
      "id": "overall_package",
      "label": "Overall Package",
      "screenshot": "screenshots/step_02_overall_package.png",
      "fields": [
        {"name": "Length D", "control": "number", "unit": "mm", "default": 4.93},
        {"name": "Width E", "control": "number", "unit": "mm", "default": 6},
        {"name": "Standoff A1", "control": "number", "unit": "mm", "default": 0.15}
      ]
    },
    {
      "id": "encapsulant",
      "label": "Encapsulant",
      "screenshot": "screenshots/step_03_encapsulant.png",
      "fields": [
        {"name": "Length D1", "control": "number", "unit": "mm", "default": 4.93},
        {"name": "Width E1", "control": "number", "unit": "mm", "default": 3.81},
        {"name": "Thickness A2", "control": "number", "unit": "mm", "default": 1.47},
        {"name": "Material Group", "control": "select", "default": "Resins", "options_ref": "common_material_groups", "screenshot": "screenshots/dropdown_material_group.png"},
        {"name": "Encapsulant Material", "control": "select", "default": "Epoxy Overmold (Typical)", "options_ref": "material_option_sets.resins", "screenshots": ["screenshots/dropdown_encapsulant_material_01.png", "screenshots/dropdown_encapsulant_material_02.png", "screenshots/dropdown_encapsulant_material_03.png", "screenshots/dropdown_encapsulant_material_04.png"]}
      ]
    },
    {
      "id": "die",
      "label": "Die",
      "screenshot": "screenshots/step_04_die.png",
      "fields": [
        {"name": "Package Power", "control": "number", "unit": "W", "default": 0, "hidden_when": {"Non-uniform Die Heat": true}},
        {"name": "Non-uniform Die Heat", "property": "nonUniformDieHeat", "control": "checkbox", "default": false},
        {"name": "Click To Edit", "control": "button", "default_enabled": false, "enabled_when": {"Non-uniform Die Heat": true}},
        {"name": "Die Length Ld", "control": "number", "unit": "mm", "default": 1.479},
        {"name": "Die Width Wd", "control": "number", "unit": "mm", "default": 1.143},
        {"name": "Die Thickness td", "control": "number", "unit": "mm", "default": 0.38},
        {"name": "Die Attach Thickness tda", "control": "number", "unit": "mm", "default": 0.038},
        {"name": "Material Group", "control": "select", "default": "Attachment Materials", "options_ref": "common_material_groups"},
        {"name": "Die Attach Material", "control": "select", "default": "DieAttach-84-1LMIS"}
      ],
      "conditional_screenshots": [
        "screenshots/conditional_nonuniform_die_heat_on.png",
        "screenshots/conditional_nonuniform_editor_type1.png",
        "screenshots/conditional_nonuniform_editor_type2.png"
      ]
    },
    {
      "id": "die_flag_and_tie_bars",
      "label": "Die Flag & Tie Bars",
      "screenshot": "screenshots/step_05_die_flag_tie_bars.png",
      "fields": [
        {"name": "Die Flag Lf", "control": "number", "unit": "mm", "default": 1.7748},
        {"name": "Die Flag Wf", "control": "number", "unit": "mm", "default": 1.3716},
        {"name": "Die Flag Thickness tf", "control": "number", "unit": "mm", "default": 0.2},
        {"name": "Metal Coverage for Die Flag Cf", "control": "number", "unit": "percent", "default": 60},
        {"name": "Die Flag Downset df", "control": "number", "unit": "mm", "default": 0.4},
        {"name": "Material Group", "control": "select", "default": "Alloys (Leadframe)", "options_ref": "common_material_groups"},
        {"name": "Die Flag Material", "control": "select", "default": "Cu-CDA-194", "options_ref": "material_option_sets.leadframe_alloys", "screenshot": "screenshots/dropdown_die_flag_material.png"},
        {"name": "Tie Bar Width Wtb", "control": "number", "unit": "mm", "default": 0.4}
      ]
    },
    {
      "id": "lead_frame",
      "label": "Lead Frame",
      "screenshot": "screenshots/step_06_lead_frame.png",
      "fields": [
        {"name": "Total Number of Leads MT", "control": "integer_spinbox", "default": 8},
        {"name": "Leadframe-Flag Gap g1", "control": "number", "unit": "mm", "default": 0.114},
        {"name": "Pitch e", "control": "number", "unit": "mm", "default": 1.27},
        {"name": "Lead Thickness tl", "control": "number", "unit": "mm", "default": 0.2},
        {"name": "Lead Width B", "control": "number", "unit": "mm", "default": 0.4},
        {"name": "Lead Frame Height h1", "control": "number", "unit": "mm", "default": 0.635},
        {"name": "Lead Foot Length Lfl", "control": "number", "unit": "mm", "default": 0.5475},
        {"name": "Material Group", "control": "select", "default": "Alloys (Leadframe)", "options_ref": "common_material_groups"},
        {"name": "Lead Frame Material", "control": "select", "default": "Cu-CDA-194", "options_ref": "material_option_sets.leadframe_alloys"},
        {
          "name": "User Defined Leadframe Coverage",
          "property": "userDefinedLeadframeCoverage",
          "control": "select",
          "default": "noDefaultIsBe",
          "options": [
            {"label": "Yes", "value": "yes"},
            {"label": "No. The default coverage is B/e", "value": "noDefaultIsBe"}
          ],
          "screenshot": "screenshots/dropdown_leadframe_coverage.png"
        },
        {"name": "Leadframe Coverage", "control": "number", "unit": "percent", "default": null, "visible_when": {"User Defined Leadframe Coverage": "yes"}}
      ],
      "conditional_screenshots": ["screenshots/conditional_user_defined_leadframe_coverage.png"]
    },
    {
      "id": "bond_wires",
      "label": "Bond Wires",
      "screenshot": "screenshots/step_07_bond_wires.png",
      "fields": [
        {"name": "Bond Wire Length Lbw", "control": "number", "unit": "mm", "default": 0.2283},
        {"name": "Bond Wire Diameter dbw", "control": "number", "unit": "mm", "default": 0.03},
        {"name": "Material Group", "control": "select", "default": "Metals", "options_ref": "common_material_groups"},
        {"name": "Material", "control": "select", "default": "Gold (Pure)", "options_ref": "material_option_sets.metals", "screenshots": ["screenshots/dropdown_bond_wire_material_01.png", "screenshots/dropdown_bond_wire_material_02.png"]},
        {"name": "Number of Bond Wires N", "control": "integer_spinbox", "default": 8}
      ]
    },
    {
      "id": "thermal_land_and_solder",
      "label": "Thermal Land & Solder",
      "screenshot": "screenshots/step_08_thermal_land_solder.png",
      "fields": [
        {"name": "Include Thermal Land and Solder", "property": "includeThermalLandAndSolder", "control": "checkbox", "default": false},
        {"name": "Land Thickness", "control": "number", "unit": "mm", "default": null, "enabled_when": {"Include Thermal Land and Solder": true}},
        {"name": "Land Material Group", "control": "select", "default": "Alloys (Leadframe)", "enabled_when": {"Include Thermal Land and Solder": true}, "options_ref": "common_material_groups"},
        {"name": "Land Material", "control": "select", "default": "No Attachment", "enabled_when": {"Include Thermal Land and Solder": true}},
        {"name": "Solder Material Group", "control": "select", "default": "Alloys (Leadframe)", "enabled_when": {"Include Thermal Land and Solder": true}, "options_ref": "common_material_groups"},
        {"name": "Solder Material", "control": "select", "default": "No Attachment", "enabled_when": {"Include Thermal Land and Solder": true}}
      ],
      "conditional_screenshots": ["screenshots/conditional_thermal_land_solder_on.png"]
    },
    {
      "id": "modeling_options",
      "label": "Modeling Options",
      "screenshot": "screenshots/step_09_modeling_options.png",
      "fields": [
        {"name": "Model Lead Frames As", "control": "read_only_single_option", "default": "Isotropic Cuboid", "options": ["Isotropic Cuboid"]},
        {"name": "Model Bond Wires As", "control": "select", "default": "Orthotropic Cuboid", "options": ["Isotropic Cuboid", "Orthotropic Cuboid"], "screenshot": "screenshots/dropdown_model_bond_wires_as.png"},
        {"name": "Localize Grid", "property": "localizeGrid", "control": "checkbox", "default": true},
        {"name": "Grid Density", "control": "select", "default": "Fine", "options": ["Coarse", "Medium", "Fine"], "enabled_when": {"Localize Grid": true}, "screenshot": "screenshots/dropdown_grid_density.png"}
      ],
      "conditional_screenshots": ["screenshots/conditional_localize_grid_off.png"]
    }
  ],
  "realized_geometry": {
    "screenshot": "screenshots/model_tree.png",
    "assemblies": [
      {"name": "Encapsulant", "children": 1},
      {"name": "Die", "children": 3},
      {"name": "Die_Flag", "children": 1},
      {"name": "Tiebar", "children": 2},
      {"name": "BondWires", "children": 8},
      {"name": "LeadFrame", "children": 10}
    ],
    "standalone_entities": ["die_attach", "CaseTemp", "z_bottom", "z_top"]
  }
}
