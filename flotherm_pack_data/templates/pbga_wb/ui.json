      "fields": [
        {"name": "Die Flag Lf", "control": "number", "unit": "mm", "default": 6.5},
        {"name": "Die Flag Wf", "control": "number", "unit": "mm", "default": 6.5},
        {"name": "Coverage Cf", "control": "number", "unit": "%", "default": 60},
        {"name": "Solder Mask Thickness", "control": "number", "unit": "mm", "default": 0.05},
        {"name": "Material Group", "control": "select", "default": "Others"},
        {"name": "Solder Mask Material", "control": "select", "default": "Solder Mask Material"}
      ]
    },
    {
      "id": "die",
      "label": "Die",
      "screenshot": "screenshots/step_05_die.png",
      "fields": [
        {"name": "Package Power", "control": "number", "unit": "W", "default": 0},
        {"name": "Non-uniform Die Heat", "control": "checkbox", "default": false},
        {"name": "Die Length Ld", "control": "number", "unit": "mm", "default": 4.5},
        {"name": "Die Width Wd", "control": "number", "unit": "mm", "default": 4.5},
        {"name": "Die Thickness td", "control": "number", "unit": "mm", "default": 0.3},
        {"name": "Die Attach Thickness tda", "control": "number", "unit": "mm", "default": 0.025},
        {"name": "Die Attach Material Group", "control": "select", "default": "Attachment Materials"},
        {"name": "Die Attach Material", "control": "select", "default": "Ablestik 8510AA"},
        {"name": "Number of Bond Wires Nw", "control": "integer_spinbox", "default": 121},
        {"name": "Extent of Bond Wire Pads Lw", "control": "number", "unit": "mm", "default": 8.5},
        {"name": "Extent of Bond Wire Pads Ww", "control": "number", "unit": "mm", "default": 8.5},
        {"name": "Bond Wire Diameter dw", "control": "number", "unit": "mm", "default": 0.03},
        {"name": "Bond Wire Material Group", "control": "select", "default": "Metals"},
        {"name": "Bond Wire Material", "control": "select", "default": "Gold (Pure)"}
      ]
    },
    {
      "id": "thermal_vias",
      "label": "Thermal Vias",
      "screenshot": "screenshots/step_06_thermal_vias.png",
