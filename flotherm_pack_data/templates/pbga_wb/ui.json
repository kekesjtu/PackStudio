        {"name": "Number of Thermal Vias in X NVx", "control": "integer_spinbox", "default": 5},
        {"name": "Number of Thermal Vias in Y NVy", "control": "integer_spinbox", "default": 5},
        {"name": "Via Diameter dv", "control": "number", "unit": "mm", "default": 0.25},
        {"name": "Via Pitch ev", "control": "number", "unit": "mm", "default": 1.27},
        {"name": "Plating Thickness tpl", "control": "number", "unit": "mm", "default": 0.025},
        {"name": "Via Depopulation", "control": "button", "default_enabled": true}
      ]
    },
    {
      "id": "metal_layers",
      "label": "Metal Layers",
      "screenshot": "screenshots/step_07_metal_layers.png",
      "fields": [
        {"name": "Material Group", "control": "select", "default": "Metals"},
        {"name": "Material of Metal", "control": "select", "default": "Copper (Pure)"},
        {"name": "Layers", "control": "table", "columns": [{"name": "Depth Zn", "unit": "mm"}, {"name": "Thickness tzn", "unit": "mm"}, {"name": "Coverage", "unit": "%"}, {"name": "Disconnect to Via", "unit": null}], "default_rows": [{"depth": null, "thickness": 0.018, "coverage": 30, "disconnectToVia": false}]}
      ]
    },
    {
      "id": "solder_balls",
      "label": "Solder Balls",
      "screenshot": "screenshots/step_08_solder_balls.png",
      "fields": [
        {"name": "Number of Solder Balls in X MD", "control": "integer_spinbox", "default": 11},
