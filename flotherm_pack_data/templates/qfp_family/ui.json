{
  "schema_version": "1.0",
  "template_id": "qfp_family",
  "software_version": "2504",
  "capture_status": "complete",
  "starter_fields": [
    {"name": "Design Name", "property": "designName", "control": "text", "default": "PQFP"},
    {
      "name": "Outline Type",
      "property": "outlineType",
      "control": "select",
      "default": "standardOutline",
      "options": [
        {"label": "Standard Outline", "value": "standardOutline"},
        {"label": "Non-Standard Outline", "value": "nonStandardOutline"}
      ],
      "screenshot": "screenshots/dropdown_outline_type.png"
    },
    {
      "name": "PQFP Package Type",
      "property": "pqfpPackageType",
      "control": "select",
      "default": "lqfp",
      "options": [
        {"label": "LQFP", "value": "lqfp"},
        {"label": "MQFP", "value": "mqfp"},
        {"label": "TQFP", "value": "tqfp"}
      ],
      "visible_when": {"outlineType": "standardOutline"},
      "screenshot": "screenshots/dropdown_package_type.png"
    },
    {
      "name": "JEDEC Footprint",
      "control": "select",
      "default": "LQFP_32_7X7mm",
      "visible_when": {"outlineType": "standardOutline"},
      "property_by_package_type": {
        "lqfp": "lqfpJedecFootprint",
        "mqfp": "mqfpJedecFootprint",
        "tqfp": "tqfpJedecFootprint"
      },
      "options_by_package_type": {
        "lqfp": [
          "LQFP_32_7X7mm", "LQFP_44_10X10mm", "LQFP_44_14X14mm", "LQFP_48_7X7mm",
          "LQFP_64_10X10mm", "LQFP_64_14X14mm", "LQFP_68_10X10mm", "LQFP_80_12X12mm",
          "LQFP_80_14X14mm", "LQFP_100_14X14mm", "LQFP_100_14X20mm", "LQFP_120_14X14mm",
          "LQFP_128_14X14mm", "LQFP_128_14X20mm", "LQFP_128_20X20mm", "LQFP_144_20X20mm",
          "LQFP_160_24X24mm", "LQFP_176_24X24mm", "LQFP_184_20X20mm", "LQFP_208_28X28mm"
        ],
        "mqfp": [
          "MQFP_44_10X10mm", "MQFP_44_14X14mm", "MQFP_52_10X10mm", "MQFP_52_14X14mm",
          "MQFP_64_10X10mm", "MQFP_64_14X14mm", "MQFP_64_14X20mm", "MQFP_80_14X14mm",
          "MQFP_80_14X20mm", "MQFP_100_14X14mm", "MQFP_100_14X20mm", "MQFP_120_28X28mm",
          "MQFP_128_14X20mm", "MQFP_128_28X28mm", "MQFP_144_28X28mm", "MQFP_160_24X24mm",
          "MQFP_160_28X28mm", "MQFP_176_24X24mm", "MQFP_184_32X32mm", "MQFP_208_28X28mm"
        ],
        "tqfp": [
          "TQFP_32_7X7mm", "TQFP_44_10X10mm", "TQFP_44_14X14mm", "TQFP_48_7X7mm",
          "TQFP_52_10X10mm", "TQFP_64_10X10mm", "TQFP_64_14X14mm", "TQFP_80_12X12mm",
          "TQFP_80_14X14mm", "TQFP_100_14X14mm", "TQFP_100_14X20mm", "TQFP_120_14X14mm",
          "TQFP_120_14X20mm", "TQFP_128_14X14mm", "TQFP_144_20X20mm", "TQFP_176_20X20mm"
        ]
      },
      "screenshots": [
        "screenshots/dropdown_jedec_lqfp.png", "screenshots/dropdown_jedec_lqfp_2.png",
        "screenshots/dropdown_jedec_mqfp.png", "screenshots/dropdown_jedec_mqfp_2.png",
        "screenshots/dropdown_jedec_tqfp.png", "screenshots/dropdown_jedec_tqfp_2.png"
      ]
    },
    {
      "name": "Die Type",
      "property": "dieType",
      "control": "select",
      "default": "actualDie",
      "options": [
        {"label": "Actual Die", "value": "actualDie"},
        {"label": "Thermal Die", "value": "thermalDie"}
      ],
      "screenshot": "screenshots/dropdown_die_type.png"
    },
    {
      "name": "Exposed Pad",
      "property": "exposedPad",
      "control": "checkbox",
      "default": false,
      "conditional_screenshot": "screenshots/conditional_exposed_pad_on_starter.png"
    }
  ],
  "common_material_groups": [
    "Alloys (Leadframe)", "Alloys (Other)", "Alloys (Solders)", "Attachment Materials",
    "Ceramics", "Metals", "Others", "Resins", "Semiconductors", "Substrate Dielectrics"
  ],
  "material_option_sets": {
    "resins": [
      "No Attachment", "Cookson-7115", "Cookson-AMC-2F1", "Cookson-AMC-2RC", "Cookson-SMT-B-1FX",
      "EME-7730LF", "Epoxy Overmold (High-k)", "Epoxy Overmold (Typical)", "G700", "Hysol 4450",
      "Material", "Material1", "Material2", "Material3", "Nitto-HC100X2", "Nitto-MP8000AN",
      "Nitto-MP8000CH4", "Nylon-6 (Typical)", "Nylon-66 (Typical)", "PLASKON7060", "PTFE (Typical)",
      "Polycarbonate (Typical)", "Polyisoprene (Hard)", "Polyisoprene (Natural)", "Polystyrene (Typical)",
      "Sumitomo-6300H", "Sumitomo-7050A2", "Sumitomo-EME1100R", "Sumitomo-EME6700",
      "Sumitomo-EME6710", "Sumitomo-EME6730B", "Sumitomo-EME7302CR", "Sumitomo-EME7351",
      "Sumitomo-EME7351LS", "Sumitomo-EME7740"
    ]
  },
  "steps": [
    {
      "id": "summary",
      "label": "Summary",
      "screenshot": "screenshots/step_01_summary.png",
      "fields": [
        {"name": "Design Name", "control": "text", "default": "PQFP"},
        {"name": "Part Number", "control": "text", "default": ""},
        {"name": "Vendor Name", "control": "text", "default": ""},
        {"name": "Max Power", "control": "number", "unit": "W", "default": null},
        {"name": "Max Operating Junction Temperature", "control": "number", "unit": "degC", "default": null},
        {"name": "Max Case Temperature", "control": "number", "unit": "degC", "default": null},
        {"name": "Notes", "control": "multiline_text", "default": ""}
      ]
    },
    {
      "id": "overall_package",
      "label": "Overall Package",
      "screenshot": "screenshots/step_02_overall_package_top.png",
      "fields": [
        {"name": "Length D", "control": "number", "unit": "mm", "default": 9},
        {"name": "Width E", "control": "number", "unit": "mm", "default": 9},
        {"name": "Standoff A1", "control": "number", "unit": "mm", "default": 0.1}
      ]
    },
    {
      "id": "encapsulant",
      "label": "Encapsulant",
      "screenshot": "screenshots/step_03_encapsulant.png",
      "fields": [
        {"name": "Length D1", "control": "number", "unit": "mm", "default": 7},
        {"name": "Width E1", "control": "number", "unit": "mm", "default": 7},
        {"name": "Thickness A2", "control": "number", "unit": "mm", "default": 1.4},
        {"name": "Material Group", "control": "select", "default": "Resins", "options_ref": "common_material_groups", "screenshot": "screenshots/dropdown_material_group.png"},
        {"name": "Encapsulant Material", "control": "select", "default": "Epoxy Overmold (Typical)", "options_ref": "material_option_sets.resins", "screenshots": ["screenshots/dropdown_encapsulant_material.png", "screenshots/dropdown_encapsulant_material_2.png", "screenshots/dropdown_encapsulant_material_3.png", "screenshots/dropdown_encapsulant_material_4.png"]}
      ]
    },
    {
      "id": "die",
      "label": "Die",
      "screenshot": "screenshots/step_04_die.png",
      "fields": [
        {"name": "Package Power", "control": "number", "unit": "W", "default": 0, "hidden_when": {"Non-uniform Die Heat": true}},
        {"name": "Non-uniform Die Heat", "property": "nonUniformDieHeat", "control": "checkbox", "default": false},
        {"name": "Click To Edit", "control": "button", "default_enabled": false, "enabled_when": {"Non-uniform Die Heat": true}},
        {"name": "Die Length Ld", "control": "number", "unit": "mm", "default": 2.1},
        {"name": "Die Width Wd", "control": "number", "unit": "mm", "default": 2.1},
        {"name": "Die Thickness td", "control": "number", "unit": "mm", "default": 0.35},
        {"name": "Die Attach Thickness tda", "control": "number", "unit": "mm", "default": 0.038},
        {"name": "Material Group", "control": "select", "default": "Attachment Materials", "options_ref": "common_material_groups"},
        {"name": "Die Attach Material", "control": "select", "default": "DieAttach-84-1LMIS"}
      ],
      "conditional_screenshots": [
        "screenshots/conditional_non_uniform_die_heat_on.png",
        "screenshots/conditional_non_uniform_die_heat_editor_type1.png",
        "screenshots/conditional_non_uniform_die_heat_editor_type2.png"
      ]
    },
    {
      "id": "die_flag_and_tie_bars",
      "label": "Die Flag & Tie Bars",
      "screenshot": "screenshots/step_05_die_flag_tie_bars.png",
      "fields": [
        {"name": "Die Flag Lf", "control": "number", "unit": "mm", "default": 2.94},
        {"name": "Die Flag Wf", "control": "number", "unit": "mm", "default": 2.94},
        {"name": "Metal Coverage for Die Flag Cf", "control": "number", "unit": "percent", "default": 60},
        {"name": "Die Flag Downset df", "control": "number", "unit": "mm", "default": 0.25},
        {"name": "Tie Bar Width Wtb", "control": "number", "unit": "mm", "default": 0.5}
      ]
    },
    {
      "id": "lead_frame",
      "label": "Lead Frame",
      "screenshot": "screenshots/step_06_lead_frame.png",
      "fields": [
        {"name": "Leadframe-Flag Gap g1", "control": "number", "unit": "mm", "default": 0.42},
        {"name": "Leadframe-Flag Gap g2", "control": "number", "unit": "mm", "default": 0.42},
        {"name": "Pitch e", "control": "number", "unit": "mm", "default": 0.8},
        {"name": "Lead Thickness tl", "control": "number", "unit": "mm", "default": 0.15},
        {"name": "Lead Width B", "control": "number", "unit": "mm", "default": 0.4},
        {"name": "Lead Frame Height h1", "control": "number", "unit": "mm", "default": 0.625},
        {"name": "Lead Foot Length Wl", "control": "number", "unit": "mm", "default": 0.4},
        {"name": "Material Group", "control": "select", "default": "Alloys (Leadframe)", "options_ref": "common_material_groups"},
        {"name": "Lead Frame Material", "control": "select", "default": "Cu-EFTEC-64T"},
        {"name": "Number of Leads on Top/Bottom MD", "control": "integer_spinbox", "default": 8},
        {"name": "Number of Leads on Left/Right ME", "control": "integer_spinbox", "default": 8},
        {
          "name": "User Defined Leadframe Coverage",
          "property": "userDefinedLeadframeCoverage",
          "control": "select",
          "default": "noDefaultIsBe",
          "options": [
            {"label": "Yes", "value": "yes"},
            {"label": "No. The default coverage is B/e", "value": "noDefaultIsBe"}
          ],
          "screenshot": "screenshots/dropdown_user_defined_leadframe_coverage.png"
        },
        {"name": "Leadframe Coverage", "control": "number", "unit": "percent", "default": null, "visible_when": {"User Defined Leadframe Coverage": "yes"}}
      ],
      "conditional_screenshots": ["screenshots/conditional_user_defined_leadframe_coverage_yes.png"]
    },
    {
      "id": "bond_wires",
      "label": "Bond Wires",
      "screenshot": "screenshots/step_07_bond_wires.png",
      "fields": [
        {"name": "Bond Wire Length On Left/Right Lbwx", "control": "number", "unit": "mm", "default": 2},
        {"name": "Bond Wire Length On Top/Bottom Lbwy", "control": "number", "unit": "mm", "default": 2},
        {"name": "Bond Wire Diameter dbw", "control": "number", "unit": "mm", "default": 0.03},
        {"name": "Material Group", "control": "select", "default": "Metals", "options_ref": "common_material_groups"},
        {"name": "Material", "control": "select", "default": "Gold (Pure)"},
        {"name": "Number of Bond Wires N", "control": "integer_spinbox", "default": 32}
      ]
    },
    {
      "id": "thermal_land_and_solder",
      "label": "Thermal Land & Solder",
      "screenshot": "screenshots/step_08_thermal_land_solder_off.png",
      "fields": [
        {"name": "Include Thermal Land and Solder", "property": "includeThermalLandAndSolder", "control": "checkbox", "default": false},
        {"name": "Land Thickness", "control": "number", "unit": "mm", "default": null, "enabled_when": {"Include Thermal Land and Solder": true}},
        {"name": "Land Material Group", "control": "select", "default": "Alloys (Leadframe)", "enabled_when": {"Include Thermal Land and Solder": true}, "options_ref": "common_material_groups"},
        {"name": "Land Material", "control": "select", "default": "No Attachment", "enabled_when": {"Include Thermal Land and Solder": true}},
        {"name": "Solder Material Group", "control": "select", "default": "Alloys (Leadframe)", "enabled_when": {"Include Thermal Land and Solder": true}, "options_ref": "common_material_groups"},
        {"name": "Solder Material", "control": "select", "default": "No Attachment", "enabled_when": {"Include Thermal Land and Solder": true}}
      ],
      "conditional_screenshots": ["screenshots/conditional_thermal_land_solder_on.png"]
    },
    {
      "id": "modeling_options",
      "label": "Modeling Options",
      "screenshot": "screenshots/step_09_modeling_options.png",
      "fields": [
        {"name": "Model Lead Frames As", "control": "select", "default": "Orthotropic Cuboid", "options": ["Isotropic Cuboid", "Orthotropic Cuboid"], "screenshot": "screenshots/dropdown_model_lead_frames_as.png"},
        {"name": "Model Bond Wires As", "control": "select", "default": "Orthotropic Cuboid", "options": ["Isotropic Cuboid", "Orthotropic Cuboid"], "screenshot": "screenshots/dropdown_model_bond_wires_as.png"},
        {"name": "Model Tie Bars As", "control": "select", "default": "Accurate", "options": ["Approximate", "Accurate"], "screenshot": "screenshots/dropdown_model_tie_bars_as.png"},
        {"name": "Localize Grid", "property": "localizeGrid", "control": "checkbox", "default": true},
        {"name": "Grid Density", "control": "select", "default": "Fine", "options": ["Coarse", "Medium", "Fine"], "enabled_when": {"Localize Grid": true}, "screenshot": "screenshots/dropdown_grid_density.png"}
      ],
      "conditional_screenshots": ["screenshots/conditional_localize_grid_off.png"]
    }
  ],
  "realized_geometry": {
    "screenshot": "screenshots/model_tree.png",
    "assemblies": [
      {"name": "Encapsulant", "children": 1},
      {"name": "Die", "children": 3},
      {"name": "Die_Flag", "children": 1},
      {"name": "BondWires", "children": 8},
      {"name": "LeadFrame", "children": 16},
      {"name": "tie_bars", "children": 8},
      {"name": "tiebar_plt", "children": 8}
    ],
    "standalone_entities": ["die_attach", "CaseTemp", "z_bottom", "z_top"]
  }
}
